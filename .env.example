# Copy to .env for local development. Never commit the real file.

# --- Model provider -------------------------------------------------------
# "openai" (default) or "anthropic"
LLM_PROVIDER=openai
# Leave blank to use the provider default (gpt-4o-mini / claude-sonnet-4-5)
LLM_MODEL=

OPENAI_API_KEY=sk-...
# Only needed behind a proxy/gateway. Leave blank for api.openai.com.
OPENAI_BASE_URL=

# Chat only. Embeddings still require OPENAI_API_KEY.
ANTHROPIC_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval ------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=6

# --- Spend protection -----------------------------------------------------
# One run is ~6 model calls. These stop a shared link becoming an open invoice.
RATE_LIMIT_PER_HOUR=5
DAILY_RUN_CAP=200
