# Copy to .env for local development. Never commit the real file.

# =============================================================================
# Default setup: one Anthropic key, nothing else.
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...

# "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Leave blank for the provider default (claude-opus-5 / gpt-4o-mini)
LLM_MODEL=

# Reasoning depth on Claude: low | medium | high | xhigh | max
# This is the cost/latency lever. `temperature` is NOT accepted on Claude
# Opus 5 — passing it returns a 400 — so effort replaces it.
LLM_EFFORT=medium

# --- Embeddings --------------------------------------------------------------
# "local" runs a small ONNX model in-process: no API key, no network call.
# Anthropic has no embeddings endpoint, so "local" is what makes a Claude-only
# deployment possible. Set to "openai" only if you have an OpenAI key and want
# hosted embeddings.
EMBEDDING_PROVIDER=local
# Blank uses BAAI/bge-small-en-v1.5 (local) or text-embedding-3-small (openai)
EMBEDDING_MODEL=

# =============================================================================
# Only needed for LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
# =============================================================================
OPENAI_API_KEY=
# Set only when routing through a proxy/gateway
OPENAI_BASE_URL=

# --- Retrieval ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=6

# --- Spend protection --------------------------------------------------------
# One run is ~6 model calls. These stop a shared link becoming an open invoice.
RATE_LIMIT_PER_HOUR=5
DAILY_RUN_CAP=200
